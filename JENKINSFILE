pipeline{
    agent any
    
    options {skipDefaultCheckout()}
    
    stages{
        stage('Get Code'){
            steps{
                git 'https://github.com/jorgesaintremy/helloworld-res.git'
                echo WORKSPACE
                sh 'ls -lart'
                stash name: 'code', includes: '**'
                deleteDir()
            }
        }
        stage('Unit'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                unstash name: 'code'
                sh '''
                    ls -lart
                    export PYTHONPATH=${WORKSPACE}
                    python3 -m pytest --junitxml=result-unit.xml test/unit
                '''
                stash name: 'unit-res', includes: 'result-unit.xml'
                deleteDir()
                }    
            }
        }
        stage('Rest'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                unstash name:'code'
                sh '''
                    ls -lart
                    whoami
                    export PYTHONPATH=${WORKSPACE}
                    export FLASK_APP=app/api.py            
                    python3 -m flask run &
                    sleep 5
                    java -jar /Users/kokomac/Documents/Jenkins/agente2/wiremock/wiremock-standalone-3.13.2.jar --port 9090 --root-dir /Users/kokomac/Documents/Jenkins/agente2/wiremock &
                    sleep 10
                    python3 -m pytest --junitxml=result-rest.xml test/rest
                '''
                }
                stash name: 'rest-res', includes: 'result-rest.xml'
                deleteDir()
            }
        }
        stage('Static'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                unstash name: 'code'
                sh '''
                    export PYTHONPATH=$WORKSPACE
                    python3 -m flake8 --format=pylint --exit-zero app>flake8.out
                '''
                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')], qualityGates : [[threshold: 8, type: 'TOTAL', unstable: true], [threshold: 10, type: 'TOTAL', unstable: false]]
                stash name: 'static-res', includes: 'flake8.out'
                deleteDir()
                }
            }
        }
        stage('Security Test'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                unstash name:'code'
                sh '''
                    python3 -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}:[{test_id}] {msg}"
                '''
                recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')], qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true], [threshold: 4, type: 'TOTAL', unstable: false]]
                deleteDir()
                }
            }
        }
        stage('Performance'){
            steps{
                unstash name:'code'
                sh '''
                    export FLASK_APP=app/api.py
                    python3 -m flask run &
                    sleep 10
                    /Users/kokomac/Documents/UNIR/Ejercicios/apache-jmeter-5.6.3/bin/jmeter -n -t test/jmeter/flask.jmx -l flask.jtl
                '''
                perfReport sourceDataFiles: 'flask.jtl'
                deleteDir()
            }
        }
        stage('Coverage'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                unstash name:'code'
                sh '''
                    ls -lart
                    whoami
                    export PYTHONPATH=${WORKSPACE}
                    python3 -m coverage run --branch --source=app --omit=app/__init__.py,app/api.py -m pytest test/unit
                    python3 -m coverage xml
                    sleep 5
                '''
                recordCoverage qualityGates: [[criticality: 'ERROR', integerThreshold: 97, metric: 'LINE', threshold:85.0], [integerThreshold: 98, metric: 'LINE', threshold: 95.0], [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0],[integerThreshold: 90, metric: 'BRANCH', threshold: 90.0]], tools:[[parser: 'COBERTURA', pattern: 'coverage.xml']]
                stash name: 'cobertura-res', includes: 'coverage.xml'
                deleteDir()
                }
            }
        }
    }
}